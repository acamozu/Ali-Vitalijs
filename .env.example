# Copy to .env.local (never commit it).
# true = mock verification in the browser, false = real SAP service
VITE_USE_MOCK=true

# Only needed for the real service (dev proxy for /sap)
SAP_HOST=
SAP_USER=
SAP_PASSWORD=
SAP_CLIENT=100

# Netlify: set SAP_HOST, SAP_USER, SAP_PASSWORD, SAP_CLIENT and ACCESS_CODE as environment
# variables of the site (Site configuration > Environment variables). netlify/functions/sap-check.mjs
# replaces the dev proxy there; VITE_USE_MOCK=false is already set in netlify.toml.
